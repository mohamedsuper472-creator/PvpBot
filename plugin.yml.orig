name: PvpBot
version: 1.0.0
main: com.stashes.pvpbot.PvpBotPlugin
api-version: '1.21'
description: Human-like PvP bots - real fake players that aim, shield, crit, mace, e-mace, regear, form armies and fight like players.
author: stashes
website: https://github.com/Nantag/Plugins_Backup
softdepend: [SkinsRestorer]

commands:
  pvpbot:
    description: Manage PvP bots.
    usage: /<command> spawn|remove|list|attack|stop|settings|reload ...
    aliases: [bot]
  ghost:
    description: Spawn scripted, non-interactable ghost NPCs.
    usage: /<command> record|stoprecord|spawn|stare|remove|list|recordings ...
    permission: pvpbot.admin

permissions:
  pvpbot.admin:
    description: Allows managing PvP bots.
    default: op
  pvpbot.stats:
    description: Allows /pvpbot stats and /pvpbot stats top (resetting them needs pvpbot.admin).
    default: true
